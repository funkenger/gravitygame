<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="#1AFFFFFF">
    <TextView android:id="@+id/txtName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold"/>
    <TextView android:id="@+id/txtStatus" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/txtBest" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
